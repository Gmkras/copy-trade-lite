# ---------------------------------------------------------------------------
# Copy-Trade Lite — environment template
# Copy to `.env` and fill in the three secrets. NEVER commit `.env`.
# Everything here is TESTNET ONLY: no mainnet config, no real funds.
# ---------------------------------------------------------------------------

# Ed25519 private key of the TESTNET wallet that signs orders.
# Format: hex with or without 0x, or the "ed25519-priv-0x…" AIP-80 string.
# Get it from https://app.decibel.trade/api ("API Wallet") or generate one with
# `pnpm tsx scripts/keygen.ts` (available from the next change), then fund the
# wallet with testnet APT at https://aptos.dev/network/faucet.
PRIVATE_KEY=

# Geomi API key (Aptos Labs infrastructure). Required: without it every SDK
# call returns 401. Create one at https://geomi.dev → Project → API Resources →
# Create API Key (network: Testnet).
APTOS_NODE_API_KEY=

# Your builder address: the Decibel *trading subaccount* that receives builder
# fees. It must be a subaccount, not a plain wallet (the chain aborts with
# EBUILDER_SUBACCOUNT_NOT_FOUND otherwise). Simplest: your own primary
# subaccount — run `pnpm smoke` after `pnpm mint` and copy the "subaccount"
# line. It is left-padded to 64 hex characters automatically.
BUILDER_ADDRESS=

# Builder fee in basis points. Protocol-wide cap is 10 (0.1%). This same value
# is used both as the approved maxFee and as the per-order builderFee; an order
# can never carry a higher fee than this constant.
BUILDER_FEE_BPS=10

# Network guard. Only "testnet" is accepted; any other value refuses to start.
DECIBEL_NETWORK=testnet

# Maximum order size (in base asset units, e.g. BTC) the app will ever sign.
# A fat-finger cap for the demo; orders above it are rejected before signing.
MAX_ORDER_SIZE=0.01

# SQLite file for the signal history (created on first use, gitignored).
DB_PATH=./data/signals.db
